{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/**,public/**,index.html,style.css,app.js}"
    },
    "server.js": {
      "includeFiles": "{data/**,public/**,index.html,style.css,app.js}"
    }
  }
}
